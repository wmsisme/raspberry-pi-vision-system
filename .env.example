# ============================================================
# 环境变量模板
# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 排除，不会提交）
#     cp .env.example .env
# ============================================================

# 阿里云百炼（DashScope）API Key —— 拍照问答与云端语义分析必需
# 获取地址: https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=your-api-key-here

# 可选：覆盖默认模型（qwen-vl-plus / qwen-vl-max）
# DASHSCOPE_MODEL=qwen-vl-plus
